{
  "name": "opale",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:tz": "node scripts/test-timezones.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "doctor": "expo-doctor",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "expo": "~58.0.19",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.5.12",
    "react": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": "eslint",
    "*.{json,md,yml,yaml}": "prettier --check"
  }
}
